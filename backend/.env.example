# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/opspilot_db

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Use 'mock' for local/demo (no API key needed)
# Use 'gemini' for real AI (requires AI_API_KEY)
AI_PROVIDER=mock
AI_API_KEY=your-gemini-api-key-here

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
